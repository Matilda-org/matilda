<%

# Tools grouped by category: each entry renders with the same tools/tool-card UI.
tools_by_category = {
  "Operatività" => [
    {
      icon: "bi-kanban-fill",
      title: "Controllo progetti su board",
      description: "Trova i progetti che non sono ancora collegati alle board operative.",
      cta: "Apri controllo",
      href: tools_projects_without_procedures_path
    }
  ],
  "Analisi" => [
    {
      icon: "bi-clock-history",
      title: "Report attività svolte",
      description: "Analizza il tempo consuntivato per periodo, progetto, board e stato.",
      cta: "Apri report",
      href: tools_projects_tasks_tracking_path
    },
    {
      icon: "bi-exclamation-triangle-fill",
      title: "Rischi progetto",
      description: "Individua progetti con task scaduti, senza owner, budget critici o attività ferme.",
      cta: "Controlla rischi",
      href: tools_project_risks_path
    }
  ],
  "Integrazioni" => [
    {
      icon: "bi-braces",
      title: "Documentazione API",
      description: "Consulta la documentazione Swagger delle API. L'autenticazione usa la API key personale, rigenerabile dal tuo profilo.",
      cta: "Apri Swagger",
      href: api_v1_docs_path,
      external: true
    }
  ]
}

%>

<%= render 'shared/page-header', title: 'Strumenti' %>

<% tools_by_category.each do |category, tools| %>
  <h2 class="fs-5 fw-semibold mb-3"><%= category %></h2>

  <%= render 'shared/page-grid' do %>
    <% tools.each do |tool| %>
      <%= render 'shared/page-grid-item' do %>
        <%= render 'tools/tool-card', tool: tool %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
