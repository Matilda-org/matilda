<%

project ||= Project.new

%>

<% if project.projects_logs.length.positive? %>
<ol class="list-group">
  <% project.projects_logs.pinned_first.each do |log| %>
    <li class="list-group-item <%= 'c-list-item--highlight' if log.pinned? %>">
      <div class="c-list-item">
        <div class="c-list-item__body">
          <div class="c-list-item__title text-truncate"><%= log.title %></div>
          <div class="c-list-item__meta">
            <span><i class="bi bi-calendar3 me-1"></i><%= log.date.strftime('%d/%m/%Y') %></span>
            <% if log.pinned? %><span class="badge rounded-pill bg-warning bg-opacity-75"><i class="bi bi-pin-angle-fill me-1"></i>In evidenza</span><% end %>
            <% if log.shareable? %><span class="badge rounded-pill bg-primary bg-opacity-75"><i class="bi bi-eye-fill me-1"></i>Condivisa</span><% end %>
          </div>
        </div>
        <div class="c-list-item__actions">
        <div class="dropdown me-1">
          <button class="btn btn-sm btn-outline" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Apri menu nota <%= log.title %>">
            <i class="bi bi-three-dots"></i>
          </button>
          <ul class="dropdown-menu">
            <% if log.pinned? %>
              <li><a class="dropdown-item" href="<%= projects_unpin_log_action_path(id: project.id, log_id: log.id) %>" data-turbo-method="post" data-turbo-frame="action">Rimuovi da in evidenza</a></li>
            <% else %>
              <li><a class="dropdown-item" href="<%= projects_pin_log_action_path(id: project.id, log_id: log.id) %>" data-turbo-method="post" data-turbo-frame="action">Metti in evidenza</a></li>
            <% end %>
            <li><hr class="dropdown-divider"></li>
            <% if log.shareable? %>
              <li>
                <div class="ps-3 pe-3">
                  <%= render 'projects/shared/log-share', log: log, small: 'true' %>
                </div>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="<%= projects_actions_path(id: project.id, type: 'unshare-log', log_id: log.id) %>" data-turbo-frame="action">Annulla condivisione</a></li>
            <% else %>
              <li><a class="dropdown-item" href="<%= projects_actions_path(id: project.id, type: 'share-log', log_id: log.id) %>" data-turbo-frame="action">Condividi</a></li>
            <% end %>
            <li><a class="dropdown-item" href="<%= projects_actions_path(id: project.id, type: 'edit-log', log_id: log.id) %>" data-turbo-frame="action">Modifica</a></li>
            <li><a class="dropdown-item text-danger" href="<%= projects_actions_path(id: project.id, type: 'remove-log', log_id: log.id) %>" data-turbo-frame="action">Elimina</a></li>
          </ul>
        </div>

        <a href="<%= projects_actions_id_path(id: project.id, type: 'show-log', log_id: log.id) %>" data-turbo-frame="action" class="btn btn-sm btn-outline-primary" aria-label="Visualizza nota <%= log.title %>"><i class="bi bi-eye"></i></a>
        </div>
      </div>
    </li>
  <% end %>
</ol>
<% else %>
  <%= render 'shared/placeholder',
    message: 'Nessuna nota',
    icon: 'journal-text',
    cta_label: 'Aggiungi nota',
    cta_href: projects_actions_path(type: 'add-log', id: project.id) %>
<% end %>
