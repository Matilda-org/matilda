<%

description = project.description_with_budget

%>

<h3 class="fs-5"><%= project.name %></h3>
<h4 class="fs-6 text-muted"><%= project.complete_code %></h4>
<% if project.contact %>
  <a href="<%= contacts_show_path(id: project.contact_id) %>" data-turbo-frame="_top" class="text-decoration-none" data-user-policies-target="item" data-policy="crm">
    <i class="bi bi-person-lines-fill me-1"></i><%= project.contact.name %>
  </a>
<% end %>
<hr />
<% if description.blank? %>
<p class="text-muted">
Nessuna descrizione
</p>
<% else %>
<div data-controller="protector" class="mb-3">
  <div data-protector-target="content" style="opacity: 0;">
    <%= simple_format description %>
  </div>
</div>
<% end %>

<%= render 'projects/shared/card-content', project: project %>