<%= render 'shared/page-header', title: 'Progetti', subtitle: @folder && link_to(@folder.name, folders_show_path(@folder), data: { turbo: false }), render_actions: 'projects/index-actions' %>

<%= render 'shared/page-preferred',
    query: @projects_preferred,
    type: 'Project',
    render_item: 'projects/shared/card-interactive',
    render_item_param: :project
  %>

<%= render 'shared/page-index',
  query: @projects,
  render_item: 'projects/shared/card-interactive',
  render_item_param: :project,
  search: true,
  filters: [
    { label: 'Attivi', value: 'not-archived', default: true },
    { label: 'Archiviati', value: 'archived' }
  ],
  sorts: [
    { label: 'Nome A-Z', value: 'name_asc', default: true },
    { label: 'Nome Z-A', value: 'name_desc' },
    { label: 'Anno crescente', value: 'year_asc' },
    { label: 'Anno decrescente', value: 'year_desc' },
    { label: 'Ultima modifica', value: 'updated_desc' }
  ],
  empty_message: 'Nessun progetto qui',
  empty_icon: 'folder2-open',
  empty_cta_label: 'Crea il primo progetto',
  empty_cta_href: projects_actions_path(type: 'create', folder_id: @folder&.id),
  empty_cta_policy: 'projects_create',
  bulk: {
    path: projects_bulk_action_path,
    policy: %w[projects_archive projects_unarchive folders_manage_resources].find { |policy| @session_user&.policy?(policy) } || 'projects_archive',
    archive_policy: 'projects_archive',
    unarchive_policy: 'projects_unarchive',
    archive_confirm_href: projects_actions_path(type: 'bulk-archive'),
    move_href: projects_actions_path(type: 'bulk-move'),
    move_policy: 'folders_manage_resources'
  }
%>