<%

has_prefer = false
has_prefer = @session_user.prefer?(@project.id, @project.class.name) if @session_user && @project
folder_data = @project.cached_folder_item_data

%>

<div class="d-flex justify-content-center align-items-center">
  <% if has_prefer %>
    <div class="me-2 text-warning" data-controller="tooltip" data-tooltip="Progetto nei preferiti">
      <i class="bi bi-bookmark-fill"></i>
    </div>
  <% end %>

  <% if @project.archived %>
    <div class="me-2 text-dark" data-controller="tooltip" data-tooltip="Progetto archiviato per <%= @project.archived_reason_string.upcase %>">
      <i class="bi bi-archive-fill"></i>
    </div>
  <% end %>

  <div class="dropdown">
    <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Apri menu progetto">
      <i class="bi bi-three-dots"></i>
    </button>
    <ul class="dropdown-menu">
      <li <%= policy_guard('tasks_index') %>>
        <a class="dropdown-item" href="<%= tasks_tracks_path(project_id: @project.id) %>" data-turbo-frame="_top">
          Tracking tempo
        </a>
      </li>

      <% if has_prefer %>
        <li>
          <a class="dropdown-item" href="<%= users_toggle_prefer_action_path(resource_id: @project.id, resource_type: @project.class.name) %>" data-turbo-method="post" data-turbo-frame="action">
            Rimuovi dai preferiti
          </a>
        </li>
      <% else %>
        <li>
          <a class="dropdown-item" href="<%= users_toggle_prefer_action_path(resource_id: @project.id, resource_type: @project.class.name) %>" data-turbo-method="post" data-turbo-frame="action">
            Aggiungi ai preferiti
          </a>
        </li>
      <% end %>

      <li <%= policy_guard('projects_edit') %>>
        <a class="dropdown-item" href="<%= projects_actions_path(type: 'edit', id: @project.id) %>" data-turbo-frame="action">
          Modifica progetto
        </a>
      </li>

      <li <%= policy_guard('folders_manage_resources') %>>
        <a class="dropdown-item" href="<%= folders_actions_path(type: 'manage-resource', item_id: folder_data&.dig(:id), resource_id: @project.id, resource_type: @project.class.name) %>" data-turbo-frame="action">
          <%= folder_data ? 'Sposta in altra cartella' : 'Aggiungi a cartella' %>
        </a>
      </li>

      <% if @project.archived %>
        <li <%= policy_guard('projects_unarchive') %>>
          <a class="dropdown-item" href="<%= projects_actions_path(type: 'unarchive', id: @project.id) %>" data-turbo-frame="action">
            Ri-attiva progetto
          </a>
        </li>
      <% else %>
        <li <%= policy_guard('projects_archive') %>>
          <a class="dropdown-item" href="<%= projects_actions_path(type: 'archive', id: @project.id) %>" data-turbo-frame="action">
            Archivia progetto
          </a>
        </li>
      <% end %>

      <li <%= policy_guard('projects_destroy') %>>
        <a class="dropdown-item text-danger" href="<%= projects_actions_path(type: 'destroy', id: @project.id) %>" data-turbo-frame="action">
          Elimina progetto
        </a>
      </li>
    </ul>
  </div>
</div>
