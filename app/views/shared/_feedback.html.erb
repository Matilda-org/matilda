<%

title ||= 'Titolo'
type ||= 'light'
subtitle ||= nil
turbo_frame ||= '_top'
render_content ||= nil
render_content_args ||= {}
# Reversible actions skip the confirm step and offer an undo here instead: { label:, href: }
undo ||= nil

%>

<div class="text-center">
  <% if type == 'success' %>
    <div class="text-success mb-3 h-fs-icon-xl">
      <i class="bi bi-check-circle"></i>
    </div>
  <% end %>
  <h3 class="fs-5 mb-1"><%= title %></h3>
  <p class="mb-4"><%= subtitle %></p>
  <a
    type="button"
    href=""
    data-turbo-frame="<%= turbo_frame %>"
    <% if turbo_frame != '_top' %>
      data-action="click->action#closeModal"
    <% end %>
    class="btn btn-primary"
  >Va bene</a>
  <% if undo %>
    <%= button_to undo[:label] || "Annulla", undo[:href], method: :post, form: { class: "d-inline-block ms-2", data: { turbo_frame: "action" } }, class: "btn btn-outline-secondary" %>
  <% end %>
</div>

<% if render_content %>
  <div class="mt-5">
    <hr>
    <h3 class="fs-5 mb-3">Dettagli</h3>
    <%= render render_content, render_content_args %>
  </div>
<% end %>