<%

query ||= ApplicationRecord.all
render_item ||= ''
render_item_param ||= 'item'

search ||= false
filters ||= []
sorts ||= []
tags ||= []

empty_message ||= nil
empty_icon ||= nil
empty_cta_label ||= nil
empty_cta_href ||= nil
empty_cta_policy ||= nil
# Bulk selection mode (bulk-select controller). Hash with:
#   path: POST endpoint taking ids[] + operation
#   policy: policy guarding the "Seleziona" toggle
#   archive_policy / unarchive_policy: policies of the archive / restore buttons
#   move_href / move_policy: optional "Sposta in cartella" modal (GET, receives ids[])
bulk ||= nil
archived_view = params[:filters] == 'archived'

# A filter counts as active only when it narrows the default view
default_filter = filters.find { |filter| filter[:default] }&.dig(:value)
filtered = params[:search].present? || params[:tags].present? ||
  (params[:filters].present? && params[:filters] != default_filter)

%>

<% if bulk %>
<div class="c-bulk-select" data-controller="bulk-select" data-bulk-select-path-value="<%= bulk[:path] %>">
  <div class="visually-hidden" role="status" aria-live="polite" data-bulk-select-target="status"></div>
<% end %>

<% if search || filters.any? || sorts.any? %>
  <%= form_tag '', method: :get, class: 'mb-2', data: { turbo_frame: 'page-index', controller: 'filters' } do %>
    <div class="row justify-content-end">
      <% if tags.length.positive? %>
        <div class="col col-12 mb-3 col-xl-auto">
          <div class="row align-items-center">
            <div class="col-auto visually-hidden">
              <label for="tags" class="col-form-label">Tag</label>
            </div>
            <div class="col">
              <select id="tags" class="form-select" name="tags" data-action="change->filters#submit">
                <option value="">Seleziona un tag</option>
                <% tags.each do |tag| %>
                  <option value="<%= tag %>" <%= params[:tags] == tag ? 'selected' : '' %>><%= tag %></option>
                <% end %>
              </select>
            </div>
          </div>
        </div>
      <% end %>

      <% if search %>
        <div class="col col-12 mb-3 col-xl-auto">
          <div class="row align-items-center">
            <div class="col-auto visually-hidden">
              <label for="search" class="col-form-label">Ricerca</label>
            </div>
            <div class="col">
              <div class="input-group">
                <input
                  type="text"
                  id="search"
                  name="search"
                  class="form-control"
                  placeholder="Ricerca"
                  aria-label="Ricerca"
                  data-filters-target="inputToClear"
                  data-action="input->filters#submitDebounced"
                  value="<%= params[:search] || '' %>"
                >
                <button class="btn btn-secondary" type="button" data-filters-target="buttonClear" data-action="click->filters#clear" aria-label="Cancella ricerca"><i class="bi bi-x-circle"></i></button>
                <button class="btn btn-primary" data-filters-target="submit" type="submit" aria-label="Cerca"><i class="bi bi-search"></i></button>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <% if sorts.any? %>
        <div class="col col-12 mb-3 col-xl-auto">
          <div class="row align-items-center">
            <div class="col-auto visually-hidden">
              <label for="sort" class="col-form-label">Ordina per</label>
            </div>
            <div class="col">
              <div class="input-group">
                <span class="input-group-text">Ordina</span>
                <select id="sort" class="form-select" name="sort" data-action="change->filters#submit">
                  <% sorts.each do |sort| %>
                    <option value="<%= sort[:value] %>" <%= params[:sort] == sort[:value] || (params[:sort].blank? && sort[:default]) ? 'selected' : '' %>><%= sort[:label] %></option>
                  <% end %>
                </select>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <% if filters.any? %>
        <div class="col col-12 mb-3 col-xl-auto">
          <div class="row align-items-center">
            <div class="col d-flex justify-content-end">
              <div class="btn-group" role="group" aria-label="Filtri">
                <% filters.each do |filter| %>
                  <input
                    type="radio"
                    class="btn-check"
                    name="filters"
                    id="<%= filter[:value] %>"
                    autocomplete="off"
                    data-action="change->filters#submit"
                    value="<%= filter[:value] %>"
                    <%= (params[:filters] == filter[:value] || (params[:filters].blank? && filter[:default])) ? 'checked' : '' %>
                  >
                  <label class="btn btn-outline-primary" for="<%= filter[:value] %>"><%= filter[:label] %></label>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <% if bulk %>
        <div class="col col-auto mb-3" <%= policy_guard(bulk[:policy]) %>>
          <button
            type="button"
            class="btn btn-outline-primary"
            aria-pressed="false"
            data-bulk-select-target="toggle"
            data-action="bulk-select#toggleMode"
          ><i class="bi bi-check2-square"></i> <span data-bulk-select-target="toggleLabel">Seleziona</span></button>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<%= turbo_frame_tag "page-index", class: 'w-100', data: (bulk ? { action: 'turbo:frame-load->bulk-select#frameLoaded' } : {}) do %>

<% if query.length.positive? %>

<% if query.respond_to?(:total_count) %>
  <div class="d-flex align-items-center gap-2 small text-muted mb-2">
    <span role="status"><%= pluralize(query.total_count, 'risultato', plural: 'risultati') %></span>
    <% if filtered %>
      <a href="<%= request.path %>" data-turbo-frame="_top">Rimuovi filtri</a>
    <% end %>
  </div>
<% end %>

<div class="row align-items-stretch">
  <% query.each do |item| %>
    <div class="col col-12 col-md-12 col-lg-6 col-xl-4 mb-3 d-flex align-items-stretch<%= ' c-bulk-select__item' if bulk %>">
      <% if bulk %>
        <input
          type="checkbox"
          class="form-check-input c-bulk-select__check"
          value="<%= item.id %>"
          aria-label="Seleziona <%= item.name %>"
          data-bulk-select-target="checkbox"
          data-action="change->bulk-select#update"
        >
      <% end %>
      <%= render render_item, { "#{render_item_param}": item } %>
    </div>
  <% end %>
</div>

<% if query.respond_to?('total_pages') && query.total_pages > 1 %>
<div class="d-flex justify-content-center mt-3">
  <%= paginate query, theme: 'bootstrap-5' %>
</div>
<% end %>

<% if bulk %>
  <div
    class="c-bulk-select__bar sticky-bottom bg-white border rounded shadow"
    role="region"
    aria-label="Azioni sugli elementi selezionati"
    data-bulk-select-target="bar"
    hidden
  >
    <%# Selection on the left (count + light text actions), operations on the right:
        secondary before primary, as in shared/confirmer %>
    <div class="c-bulk-select__summary">
      <span class="fw-semibold" data-bulk-select-target="count">0 selezionati</span>
      <button type="button" class="btn btn-link btn-sm" data-action="bulk-select#selectAll">Seleziona tutti in pagina</button>
      <button type="button" class="btn btn-link btn-sm" data-action="bulk-select#clearSelection">Deseleziona</button>
    </div>
    <div class="c-bulk-select__actions">
      <% if bulk[:move_href] %>
        <div <%= policy_guard(bulk[:move_policy]) %>>
          <%= form_tag bulk[:move_href], method: :get, data: { turbo_frame: 'action', action: 'submit->bulk-select#fillIds' } do %>
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-folder-symlink me-1" aria-hidden="true"></i>Sposta in cartella…</button>
          <% end %>
        </div>
      <% end %>
      <div <%= policy_guard(archived_view ? bulk[:unarchive_policy] : bulk[:archive_policy]) %>>
        <%= form_tag bulk[:path], data: { turbo_frame: 'action', action: 'submit->bulk-select#fillIds' } do %>
          <%= hidden_field_tag :operation, archived_view ? 'unarchive' : 'archive', id: nil %>
          <% if archived_view %>
            <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Ripristina</button>
          <% else %>
            <button type="submit" class="btn btn-primary"><i class="bi bi-archive me-1" aria-hidden="true"></i>Archivia</button>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% else %>

<div class="text-center pt-5 pb-5">
  <% if filtered %>
    <% message = params[:search].present? ? "Nessun risultato per \"#{params[:search]}\"" : 'Nessun elemento con questi filtri' %>
    <%= render 'shared/placeholder', message: message, icon: params[:search].present? ? 'search' : 'funnel' %>
    <a class="btn btn-outline-primary" href="<%= request.path %>" data-turbo-frame="_top">Rimuovi filtri</a>
  <% else %>
    <%= render 'shared/placeholder',
        message: empty_message || 'Nessun elemento da visualizzare',
        icon: empty_icon || 'book',
        cta_label: empty_cta_label,
        cta_href: empty_cta_href,
        cta_policy: empty_cta_policy %>
  <% end %>
</div>

<% end %>

<% end %>

<% if bulk %>
</div>
<% end %>
