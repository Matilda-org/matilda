<%= render 'shared/action-container', title: 'Visualizza credenziale' do %>
  <p class="text-muted small">
    Ultima visualizzazione:
    <%= @credential.last_viewed_at ? @credential.last_viewed_at.strftime('%d/%m/%Y %H:%M') : 'mai' %>
  </p>

  <%= render 'credentials/shared/module-infos', credential: @credential %>
<% end %>