<%# unlock panel shared by credentials-viewer and credentials-form: the
    password is checked in the browser against the encrypted phrase %>
<div class="mb-3" data-<%= controller %>-target="unlock" hidden>
  <label for="credentials-unlock-password" class="form-label">Password di criptazione</label>
  <div class="input-group">
    <input type="password" class="form-control" id="credentials-unlock-password" autocomplete="off" aria-describedby="credentials-unlock-error" data-<%= controller %>-target="unlockPassword" data-action="keydown.enter-><%= controller %>#unlock">
    <button type="button" class="btn btn-primary" data-action="<%= controller %>#unlock">Sblocca</button>
  </div>
  <small class="text-danger d-block mt-1" id="credentials-unlock-error" role="alert" data-<%= controller %>-target="unlockError"></small>
</div>
