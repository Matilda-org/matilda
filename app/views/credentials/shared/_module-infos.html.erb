<div data-controller="credentials-viewer" data-credentials-viewer-phrase-value="<%= Setting.get('credentials_phrase') %>">
  <%= render 'credentials/shared/unlock', controller: 'credentials-viewer' %>

  <div data-credentials-viewer-target="content" hidden>
    <div class="input-group mb-3" data-controller="clipboard" data-clipboard-success-content="Copiato!">
      <input class="form-control" name="username" placeholder="Username" aria-label="Username" data-value="<%= credential.secure_username %>" data-credentials-viewer-target="input" data-clipboard-target="source" readonly />
      <button type="button" class="btn btn-primary" data-action="clipboard#copy" data-clipboard-target="button">Copia</button>
    </div>

    <div class="input-group mb-3" data-controller="clipboard" data-clipboard-success-content="Copiato!">
      <input class="form-control" type="password" name="password" placeholder="Password" aria-label="Password" data-value="<%= credential.secure_password %>" data-credentials-viewer-target="input password" data-clipboard-target="source" readonly />
      <button type="button" class="btn btn-outline-secondary" aria-label="Mostra password" aria-pressed="false" data-credentials-viewer-target="passwordToggle" data-action="credentials-viewer#togglePassword">
        <i class="bi bi-eye" aria-hidden="true"></i>
      </button>
      <button type="button" class="btn btn-primary" data-action="clipboard#copy" data-clipboard-target="button">Copia</button>
    </div>

    <div class="mb-3">
      <textarea class="form-control" name="content" rows="5" placeholder="Content" aria-label="Contenuto" data-value="<%= credential.secure_content %>" data-credentials-viewer-target="input" readonly></textarea>
    </div>

    <%# Opening a credential copies its password: the usual reason to open one %>
    <div class="form-text text-secondary text-center" role="status" data-credentials-viewer-target="copyNotice"></div>
  </div>
</div>
