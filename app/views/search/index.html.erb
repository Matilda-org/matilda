<%

groups = [
  { key: :projects, label: "Progetti", icon: "projects", href: ->(r) { projects_show_path(r) }, frame: "_top", title: ->(r) { r.name }, subtitle: ->(r) { r.code } },
  { key: :tasks, label: "Task", icon: "tasks", href: ->(r) { tasks_actions_path(type: "show", id: r.id) }, frame: "action", title: ->(r) { r.title }, subtitle: ->(r) { r.cached_project_name } },
  { key: :procedures, label: "Board", icon: "procedures", href: ->(r) { procedures_show_path(r) }, frame: "_top", title: ->(r) { r.name }, subtitle: ->(_r) { nil } },
  { key: :credentials, label: "Credenziali", icon: "credentials", href: ->(r) { credentials_actions_path(type: "show", id: r.id) }, frame: "action", title: ->(r) { r.name }, subtitle: ->(_r) { nil } }
]

%>

<%= turbo_frame_tag "global-search-results" do %>
  <% if !@global_search.valid? %>
    <%= render "search/hint" %>
  <% else %>
    <% if @results.values.all?(&:empty?) %>
      <div class="c-global-search__empty">Nessun risultato per “<%= @global_search.search %>”</div>
    <% end %>

    <% groups.each do |group| %>
      <% records = @results[group[:key]] %>
      <% next if records.empty? %>
      <div role="group" aria-labelledby="global-search-group-<%= group[:key] %>">
        <div class="c-global-search__group" id="global-search-group-<%= group[:key] %>" role="presentation"><%= group[:label] %></div>
        <% records.each do |record| %>
          <% subtitle = group[:subtitle].call(record) %>
          <a
            href="<%= group[:href].call(record) %>"
            id="global-search-option-<%= group[:key] %>-<%= record.id %>"
            class="c-global-search__option"
            role="option"
            aria-selected="false"
            tabindex="-1"
            data-turbo-frame="<%= group[:frame] %>"
            data-turbo-prefetch="false"
          >
            <%= nav_icon(group[:icon], "c-global-search__option-icon") %>
            <span class="c-global-search__option-title"><%= group[:title].call(record) %></span>
            <% if subtitle.present? %>
              <span class="c-global-search__option-subtitle"><%= subtitle %></span>
            <% end %>
          </a>
        <% end %>
      </div>
    <% end %>

    <a
      href="<%= users_show_path(@session_user_id, search: @global_search.search) %>"
      id="global-search-option-all"
      class="c-global-search__option c-global-search__option--all"
      role="option"
      aria-selected="false"
      tabindex="-1"
      data-turbo-frame="_top"
    >
      <i class="bi bi-search c-global-search__option-icon" aria-hidden="true"></i>
      <span class="c-global-search__option-title">Vedi tutti i risultati</span>
    </a>
  <% end %>
<% end %>
