<%

follow_user_id ||= nil

%>

<div class="accordion-item">
  <h2 class="accordion-header">
    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#formTaskAccordionUsers" aria-expanded="false" aria-controls="formTaskAccordionUsers">
      Follower
    </button>
  </h2>
  <div id="formTaskAccordionUsers" class="accordion-collapse collapse" data-bs-parent="#formTaskAccordion">
    <div class="accordion-body">
      <div class="row">
        <div class="col col-12 mb-3">
          <%= hidden_field_tag 'tasks_followers_user_ids[]', '' %>
          <label for="tasks_followers_user_ids" class="form-label">Seguito da</label>
          <%= select_tag 'tasks_followers_user_ids', options_for_select(users_for_select, (task.persisted? || task.tasks_followers_user_ids.present?) ? task.tasks_followers_user_ids : (follow_user_id ? [follow_user_id] : []) ), class: 'form-select', multiple: true %>
        </div>
      </div>
    </div>
  </div>
</div>
