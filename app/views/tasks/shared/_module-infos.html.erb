<%= render 'tasks/shared/inline-field', task: task, field: 'title', frame_class: 'd-block mb-2' %>
<%= render 'tasks/shared/inline-field', task: task, field: 'deadline', frame_class: 'd-block mb-2' %>
<%= render 'tasks/shared/card-content', task: task, editable: true %>

<hr />
<% if task.description.blank? %>
<p class="text-muted">
Nessuna descrizione
</p>
<% else %>
<%= task.content %>
<% end %>
