<%

task ||= Task.new
turbo_frame_key ||= '_top'
badge_type = task.color_type
checks = task.tasks_checks.to_a
checks_done = checks.count(&:checked)
comments_count = task.tasks_comments_count.to_i

%>

<%# Compact task card for dense lists (dashboard, calendar/people boards): no description or full checklist, the whole card opens the task modal %>
<div class="c-card c-card--task c-task-compact card w-100 bg-<%= badge_type %>">
  <div class="card-body p-2">
    <div class="d-flex justify-content-between align-items-start gap-2">
      <div class="c-task-compact__main">
        <% if task.project_id %>
          <div class="c-task-compact__project text-muted h-text-oneline"><%= task.cached_project_name %></div>
        <% end %>
        <div class="fw-semibold <%= task.completed ? 'text-decoration-line-through' : '' %>"><%= task.title_with_filtered_long_words %></div>
      </div>
      <% if task.persisted? && !task.completed && task.accepted %>
        <a
          href="<%= tasks_complete_action_path(task, turbo_frame_key: turbo_frame_key) %>"
          data-turbo-method="post"
          data-turbo-frame="action"
          class="btn btn-success btn-sm border-2 flex-shrink-0"
          data-controller="tooltip"
          data-tooltip="Completa"
          aria-label="Completa task <%= task.title %>"
          <%= policy_guard('tasks_complete') %>
        ><i class="bi bi-check-circle-fill"></i></a>
      <% end %>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-1 mt-1 small">
      <% if task.user_id %>
        <span class="me-1"><%= render 'users/shared/preview', user_id: task.user_id, type: badge_type %></span>
      <% end %>
      <% if task.deadline %>
        <span class="badge bg-<%= badge_type %>" title="Scadenza"><i class="bi bi-calendar-event"></i> <%= task.deadline.strftime('%d/%m') %></span>
      <% end %>
      <% if checks.any? %>
        <span class="badge bg-<%= badge_type %>" title="Checklist completata"><i class="bi bi-check2-square"></i> <%= checks_done %>/<%= checks.size %></span>
      <% end %>
      <% if comments_count.positive? %>
        <span class="badge bg-<%= badge_type %>" title="Commenti"><i class="bi bi-chat-dots-fill"></i> <%= comments_count %></span>
      <% end %>
      <% if !task.accepted %>
        <span class="badge bg-danger"><i class="bi bi-bell-fill"></i> da approvare</span>
      <% end %>
    </div>

    <% if task.persisted? %>
      <a class="stretched-link" href="<%= tasks_actions_path(type: 'show', id: task.id) %>" data-turbo-frame="action" aria-label="Visualizza task <%= task.title %>" <%= policy_guard('tasks_show') %>></a>
    <% end %>
  </div>
</div>
