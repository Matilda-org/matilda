<%

durations = [
  ['15 min', 900],
  ['30 min', 1800],
  ['1 h', 3600],
  ['2 h', 7200],
  ['4 h', 14400],
  ['6 h', 21600],
  ['8 h', 28800],
  ['12 h', 43200],
  ['Personalizzato', 'custom']
]

%>

<%= render 'shared/action-container', title: 'Aggiungi tempo di lavoro' do %>

  <% if flash.now[:danger].present? %>
    <div class="alert alert-danger"><%= flash.now[:danger] %></div>
  <% end %>

  <%= form_tag tasks_add_track_action_path(id: @task.id, turbo_frame_key: params[:turbo_frame_key]),
        class: 'c-modal-form', data: { controller: 'manual-track form-loading' } do %>

    <div class="c-modal-form__fields">
      <p class="text-muted">Registra del tempo di lavoro per questo task scegliendo il giorno e una durata, oppure inserendone una personalizzata.</p>

      <div class="mb-3">
        <label for="date" class="form-label">Giorno</label>
        <input
          type="date"
          class="form-control"
          id="date"
          name="date"
          value="<%= Date.today.strftime('%Y-%m-%d') %>"
          max="<%= Date.today.strftime('%Y-%m-%d') %>"
          required
        >
      </div>

      <div class="mb-2">
        <label class="form-label">Durata</label>
        <input type="hidden" name="duration" value="<%= params[:duration] %>" data-manual-track-target="duration">
        <div class="row row-cols-4 g-2">
          <% durations.each do |label, value| %>
            <div class="<%= value == 'custom' ? 'col-12' : 'col' %>">
              <button
                type="button"
                class="btn btn-outline-primary w-100<%= ' active' if params[:duration].to_s == value.to_s %>"
                data-manual-track-target="button"
                data-seconds="<%= value %>"
                data-action="click->manual-track#select"
              ><%= label %></button>
            </div>
          <% end %>
        </div>

        <div class="mt-3" data-manual-track-target="custom" <%= 'hidden' unless params[:duration] == 'custom' %>>
          <div class="input-group">
            <input
              type="number"
              class="form-control<%= ' is-invalid' if @duration_error %>"
              id="hours"
              name="hours"
              value="<%= params[:hours] %>"
              min="0"
              max="24"
              step="1"
              inputmode="numeric"
              placeholder="0"
              aria-label="Ore"
              data-manual-track-target="hours"
            >
            <span class="input-group-text">h</span>
            <input
              type="number"
              class="form-control<%= ' is-invalid' if @duration_error %>"
              id="minutes"
              name="minutes"
              value="<%= params[:minutes] %>"
              min="0"
              max="59"
              step="1"
              inputmode="numeric"
              placeholder="0"
              aria-label="Minuti"
            >
            <span class="input-group-text">min</span>
          </div>
        </div>

        <% if @duration_error %>
          <div class="invalid-feedback d-block"><%= @duration_error %></div>
        <% end %>
      </div>
    </div>

    <div class="c-modal-form__submit">
      <button
        type="submit"
        class="btn btn-primary btn-form-submit"
        data-manual-track-target="submit"
        data-form-loading-target="submit"
        <%= "disabled" if params[:duration].blank? %>
      >Aggiungi tempo</button>
    </div>

  <% end %>

<% end %>
