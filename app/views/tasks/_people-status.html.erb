<%

user ||= User.new
tasks ||= []
move_context ||= {}
turbo_frame_key = "tasks-people-status-#{user.id}"

total_time_sum = tasks.sum(&:time_estimate)

# drop target value: the user id, or blank for the "unassigned" column
container_value = user.persisted? ? user.id : ""
sorted_tasks = tasks.sort_by { |t| t.completed ? 1 : 0 }

%>

<%= turbo_frame_tag turbo_frame_key do %>
  <div class="c-kanban__status card d-flex flex-direction-column justify-content-between me-3">
    <div class="c-kanban__status-header card-header d-flex align-items-center justify-content-between border-bottom-0 rounded-bottom">
      <div class="h-text-oneline">
        <%= user.complete_name.blank? ? 'Non assegnato' : user.complete_name %>
      </div>
      <div class="ms-3">
        <span
          class="badge rounded-pill text-white bg-<%= tasks_time_estimate_color(tasks) %>"
        >
          <%= track_time total_time_sum %>
        </span>
        <span
          class="badge rounded-pill text-white <%= tasks.length.positive? ? 'bg-info' : 'bg-dark' %>"
        >
          <%= tasks.select(&:completed).length %> / <%= tasks.length %>
        </span>
      </div>
    </div>
    <ul class="list-group list-group-flush h-fullscroll c-kanban__container" data-kanban-target="container" data-container="<%= container_value %>" data-status-title="<%= user.complete_name.blank? ? 'Non assegnato' : user.complete_name %>"><%= safe_join(sorted_tasks.map { |task| render("tasks/people-item", task: task, move_context: move_context) }) %></ul>
  </div>
<% end %>