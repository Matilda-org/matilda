<%

date_start ||= Date.today
date_end ||= Date.today
user_id ||= nil
project_id ||= nil

this_week_start = Date.today.at_beginning_of_week
is_this_week = date_start == this_week_start && date_end == Date.today.at_end_of_week
filters_count = [ user_id, project_id ].count(&:present?)

%>

<div class="mb-4">
  <div class="d-flex justify-content-between align-items-center gap-2">
    <h2 class="fs-4 mb-0"><%= date_start.strftime('%d/%m') %> - <%= date_end.strftime('%d/%m') %></h2>
    <div class="d-flex gap-1">
      <button class="btn btn-outline-primary d-lg-none position-relative" type="button" data-bs-toggle="collapse" data-bs-target="#tasks-calendar-filters" aria-expanded="false" aria-controls="tasks-calendar-filters">
        <i class="bi bi-funnel"></i> Filtri
        <% if filters_count.positive? %>
          <span class="badge rounded-pill bg-primary ms-1"><%= filters_count %></span>
        <% end %>
      </button>
      <%= link_to tasks_path(date_start: date_start.at_beginning_of_week - 7.days, date_end: date_start.at_beginning_of_week - 1.days, user_id: user_id, project_id: project_id), class: 'btn btn-primary', aria: { label: 'Settimana precedente' } do %>
        <i class="bi bi-arrow-left"></i>
      <% end %>
      <%= link_to 'Oggi', tasks_path(user_id: user_id, project_id: project_id), class: "btn btn-outline-primary #{'disabled' if is_this_week}", aria: { disabled: is_this_week, label: 'Torna alla settimana corrente' } %>
      <%= link_to tasks_path(date_start: date_start.at_beginning_of_week + 7.days, date_end: date_start.at_beginning_of_week + 13.days, user_id: user_id, project_id: project_id), class: 'btn btn-primary', aria: { label: 'Settimana successiva' } do %>
        <i class="bi bi-arrow-right"></i>
      <% end %>
    </div>
  </div>

  <form id="tasks-calendar-filters" class="collapse d-lg-block mt-3" method="GET" data-controller="auto-submit" data-action="change->auto-submit#submit">
    <div class="row g-2 justify-content-lg-end">
      <div class="col-12 col-sm-6 col-lg-auto c-filter-select">
        <label for="project_id" class="visually-hidden">Progetto</label>
        <%= select_tag 'project_id', options_for_select([['Tutti i progetti', '']] + @filter_projects, project_id), class: 'form-select' %>
      </div>
      <div class="col-12 col-sm-6 col-lg-auto c-filter-select">
        <label for="user_id" class="visually-hidden">Assegnati a</label>
        <%= select_tag 'user_id', options_for_select([['Tutti gli assegnatari', '']] + @filter_users, user_id), class: 'form-select' %>
      </div>
      <div class="col-6 col-lg-auto">
        <label for="date_start" class="visually-hidden">Dal</label>
        <input type="date" class="form-control" id="date_start" name="date_start" value="<%= date_start %>" required data-controller="tasks-inputdate">
      </div>
      <div class="col-6 col-lg-auto">
        <label for="date_end" class="visually-hidden">Al</label>
        <input type="date" class="form-control" id="date_end" name="date_end" value="<%= date_end %>" required data-controller="tasks-inputdate">
      </div>
    </div>
  </form>
</div>
