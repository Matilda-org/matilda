<%

folder ||= Folder.new

%>

<div class="text-center py-3">
  <div class="c-list-item__icon rounded-circle bg-primary bg-opacity-10 text-primary mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2rem;">
    <i class="bi bi-folder-fill"></i>
  </div>
  <h3 class="fs-5 mb-1"><%= folder.name %></h3>
  <div class="text-muted mb-3">Cartella</div>

  <div class="d-flex justify-content-center flex-wrap gap-2 text-muted" style="font-size: 13px;">
    <span><i class="bi bi-calendar3 me-1"></i>Creata il <%= folder.created_at.strftime('%d/%m/%Y') %></span>
    <span><i class="bi bi-clock-history me-1"></i>Aggiornata il <%= folder.updated_at.strftime('%d/%m/%Y') %></span>
  </div>
</div>
