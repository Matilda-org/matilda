<%= render 'shared/action-container', title: 'Collega progetto', turbo_frame: 'module-projects' do %>
  <% available_projects = Project.where(contact_id: nil).order(year: :desc, name: :asc) %>

  <% if available_projects.any? %>
    <%= form_tag contacts_link_project_action_path(@contact), class: 'row', data: { controller: 'form-loading' } do %>
      <div class="col col-12 mb-3">
        <label for="project_id" class="form-label">Progetto</label>
        <%= select_tag 'project_id', options_for_select(available_projects.map { |p| [p.complete_code_name, p.id] }), class: 'form-control', required: true %>
      </div>

      <div class="d-flex justify-content-end align-items-center">
        <button type="submit" class="btn btn-primary" data-form-loading-target="submit">Conferma</button>
      </div>
    <% end %>
  <% else %>
    <%= render 'shared/placeholder',
      message: 'Nessun progetto disponibile: sono tutti già collegati ad un contatto',
      icon: 'file-earmark-text' %>
  <% end %>
<% end %>
