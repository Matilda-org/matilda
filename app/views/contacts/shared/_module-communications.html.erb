<%

contact ||= Contact.new
communications = contact.communications.includes(:campaign).order(created_at: :desc)

%>

<% if communications.any? %>
<ol class="list-group">
  <% communications.each do |communication| %>
    <li class="list-group-item list-group-item-action position-relative">
      <div class="c-list-item">
        <div class="c-list-item__icon rounded-circle bg-<%= communication.status_color %> bg-opacity-10 text-<%= communication.status_color %>">
          <i class="bi <%= communication.status_icon %>"></i>
        </div>

        <div class="c-list-item__body">
          <div class="c-list-item__title text-truncate">
            <%# tutta la riga apre il board della campagna %>
            <a href="<%= campaigns_show_path(id: communication.campaign_id) %>" data-turbo-frame="_top" class="text-decoration-none stretched-link"><%= communication.campaign.name %></a>
          </div>
          <div class="c-list-item__meta">
            <span class="badge rounded-pill bg-<%= communication.status_color %> bg-opacity-75"><%= communication.status_string %></span>
            <% if communication.sent? %>
              <span><i class="bi bi-hourglass-split me-1"></i>in attesa da <%= communication.days_waiting %>g</span>
            <% elsif communication.closed_date %>
              <span><i class="bi bi-flag me-1"></i><%= communication.closed_date.strftime('%d/%m/%Y') %></span>
            <% else %>
              <span><i class="bi bi-calendar3 me-1"></i><%= communication.created_at.strftime('%d/%m/%Y') %></span>
            <% end %>
            <% if communication.follow_ups_count.positive? %>
              <span><i class="bi bi-arrow-repeat me-1"></i><%= communication.follow_ups_count %></span>
            <% end %>
            <% if communication.communications_logs.size.positive? %>
              <span><i class="bi bi-journal-text me-1"></i><%= communication.communications_logs.size %></span>
            <% end %>
          </div>
        </div>

        <div class="c-list-item__actions text-primary">
          <i class="bi bi-kanban me-1"></i><i class="bi bi-chevron-right"></i>
        </div>
      </div>
    </li>
  <% end %>
</ol>
<% else %>
  <%= render 'shared/placeholder',
    message: 'Nessuna comunicazione: aggiungi il contatto ad una campagna',
    icon: 'megaphone',
    cta_label: 'Vai alle campagne',
    cta_href: campaigns_path,
    cta_turbo_frame: '_top' %>
<% end %>
