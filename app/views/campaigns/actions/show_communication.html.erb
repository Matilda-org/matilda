<%= render 'shared/action-container', title: 'Dettaglio comunicazione', turbo_frame: 'campaign-kanban', size: 'lg', body_classes: 'c-comm-overlay__body' do %>

<%
follow_ups = @communication.communications_follow_ups.recent_first
logs = @communication.communications_logs.recent_first
# Il modale può convivere con altri contenuti in pagina: id univoci per i tab.
tabs_id = SecureRandom.hex(3)
# le azioni su follow-up e note ri-renderizzano l'overlay: torna sul tab da cui
# è partita l'azione invece di ripartire dal primo
notes_tab_active = @active_tab == "notes"
%>

<div class="c-comm-overlay">
  <div class="d-flex justify-content-between align-items-start gap-2">
    <div style="min-width: 0">
      <h3 class="fs-5 mb-1 text-truncate"><%= @communication.contact.name %></h3>
      <h4 class="fs-6 text-muted mb-0"><%= @communication.campaign.name %></h4>
    </div>

    <%# le azioni che fanno avanzare lo stato, le stesse della card sul board %>
    <div class="flex-shrink-0" data-user-policies-target="item" data-policy="crm">
      <% if @communication.to_send? %>
        <a href="<%= campaigns_actions_path(type: 'send-communication', id: @campaign.id, communication_id: @communication.id) %>" data-turbo-frame="action" class="btn btn-sm btn-primary">
          <i class="bi bi-send me-1"></i>Invia
        </a>
      <% elsif @communication.sent? %>
        <a href="<%= campaigns_actions_path(type: 'close-communication', id: @campaign.id, communication_id: @communication.id) %>" data-turbo-frame="action" class="btn btn-sm btn-primary">
          <i class="bi bi-flag me-1"></i>Esito
        </a>
      <% end %>
    </div>
  </div>

  <div class="mt-2">
    <span class="badge rounded-pill bg-<%= @communication.status_color %>"><i class="bi <%= @communication.status_icon %> me-1"></i><%= @communication.status_string %></span>
    <% if @communication.sent_date %><span class="badge rounded-pill bg-secondary bg-opacity-75"><i class="bi bi-send me-1"></i>Inviata il <%= @communication.sent_date.strftime('%d/%m/%Y') %></span><% end %>
    <% if @communication.closed_date %><span class="badge rounded-pill bg-secondary bg-opacity-75"><i class="bi bi-flag me-1"></i>Chiusa il <%= @communication.closed_date.strftime('%d/%m/%Y') %></span><% end %>
  </div>

  <%# follow-up e note competevano per lo stesso spazio: separati in due tab %>
  <ul class="nav nav-tabs mt-3 flex-shrink-0" role="tablist">
    <li class="nav-item" role="presentation">
      <button
        class="nav-link <%= 'active' unless notes_tab_active %>"
        type="button"
        role="tab"
        data-bs-toggle="tab"
        data-bs-target="#communication-tab-follow-ups-<%= tabs_id %>"
        aria-controls="communication-tab-follow-ups-<%= tabs_id %>"
        aria-selected="<%= !notes_tab_active %>"
      >
        Follow-up
        <span class="badge rounded-pill bg-secondary ms-1 <%= 'd-none' unless follow_ups.size.positive? %>"><%= follow_ups.size %></span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button
        class="nav-link <%= 'active' if notes_tab_active %>"
        type="button"
        role="tab"
        data-bs-toggle="tab"
        data-bs-target="#communication-tab-notes-<%= tabs_id %>"
        aria-controls="communication-tab-notes-<%= tabs_id %>"
        aria-selected="<%= notes_tab_active %>"
      >
        Note
        <span class="badge rounded-pill bg-secondary ms-1 <%= 'd-none' unless logs.size.positive? %>"><%= logs.size %></span>
      </button>
    </li>
  </ul>

  <div class="tab-content c-comm-overlay__panes">
    <div
      class="tab-pane c-comm-overlay__pane fade <%= 'show active' unless notes_tab_active %>"
      id="communication-tab-follow-ups-<%= tabs_id %>"
      role="tabpanel"
    >
      <% if @communication.sent? %>
        <a
          href="<%= campaigns_follow_up_communication_action_path(id: @campaign.id, communication_id: @communication.id) %>"
          data-turbo-method="post"
          data-turbo-frame="action"
          class="btn btn-outline-primary w-100 mb-3"
          data-user-policies-target="item"
          data-policy="crm"
        ><i class="bi bi-arrow-repeat me-1"></i>Registra follow-up di oggi</a>
      <% end %>

      <% if follow_ups.any? %>
        <ol class="list-group">
          <% follow_ups.each do |follow_up| %>
            <li class="list-group-item">
              <div class="c-list-item">
                <div class="c-list-item__body">
                  <div class="c-list-item__title"><%= follow_up.date.strftime('%d/%m/%Y') %></div>
                  <% if follow_up.user %>
                    <div class="c-list-item__meta"><span><i class="bi bi-person me-1"></i><%= follow_up.user.complete_name %></span></div>
                  <% end %>
                </div>
                <div class="c-list-item__actions">
                  <a
                    href="<%= campaigns_remove_communication_follow_up_action_path(id: @campaign.id, communication_id: @communication.id, follow_up_id: follow_up.id) %>"
                    data-turbo-method="post"
                    data-turbo-frame="action"
                    class="btn btn-sm btn-outline text-danger"
                    data-controller="tooltip"
                    data-tooltip="Annulla follow-up"
                    aria-label="Annulla follow-up del <%= follow_up.date.strftime('%d/%m/%Y') %>"
                  ><i class="bi bi-x-circle"></i></a>
                </div>
              </div>
            </li>
          <% end %>
        </ol>
      <% else %>
        <%= render 'shared/placeholder',
          message: @communication.to_send? ? 'I follow-up si registrano dopo l\'invio' : 'Nessun follow-up registrato',
          icon: 'arrow-repeat' %>
      <% end %>
    </div>

    <div
      class="tab-pane c-comm-overlay__pane fade <%= 'show active' if notes_tab_active %>"
      id="communication-tab-notes-<%= tabs_id %>"
      role="tabpanel"
    >
      <%= render 'shared/form-errors', item: @log if @log %>

      <%= form_tag campaigns_add_communication_log_action_path(id: @campaign.id, communication_id: @communication.id), class: 'mb-4', data: { controller: 'form-loading' } do %>
        <%# altezza standard: cresce col contenuto, ma lascia visibili le note sotto %>
        <div class="mb-2">
          <%= rich_text_area_tag :content, @log&.content, class: 'trix-content' %>
        </div>
        <div class="d-flex justify-content-end align-items-center">
          <button type="submit" class="btn btn-primary" data-form-loading-target="submit">Aggiungi nota</button>
        </div>
      <% end %>

      <% if logs.any? %>
        <% logs.each do |log| %>
          <div class="c-comm-note">
            <div class="c-comm-note__header">
              <span>
                <i class="bi bi-calendar3 me-1"></i><%= log.created_at.strftime('%d/%m/%Y %H:%M') %>
                <% if log.user %><span class="ms-2"><i class="bi bi-person me-1"></i><%= log.user.complete_name %></span><% end %>
              </span>
              <a
                href="<%= campaigns_remove_communication_log_action_path(id: @campaign.id, communication_id: @communication.id, log_id: log.id) %>"
                data-turbo-method="post"
                data-turbo-frame="action"
                class="btn btn-sm btn-outline text-danger"
                data-controller="tooltip"
                data-tooltip="Elimina nota"
                aria-label="Elimina nota"
              ><i class="bi bi-trash"></i></a>
            </div>
            <div class="c-comm-note__body trix-content">
              <%= log.content %>
            </div>
          </div>
        <% end %>
      <% else %>
        <%= render 'shared/placeholder',
          message: 'Nessuna nota per questa comunicazione',
          icon: 'journal-text' %>
      <% end %>
    </div>
  </div>
</div>
<% end %>
