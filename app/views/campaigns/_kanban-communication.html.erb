<%

campaign ||= Campaign.new
communication ||= Communication.new
contact = communication.contact
logs_count = communication.communications_logs.size
follow_ups_count = communication.follow_ups_count
silence = communication.days_since_last_activity

%>

<%# tutta la card apre il dettaglio: le azioni vivono nell'overlay, così non ci
    sono menu e bottoni che competono con il click sulla card %>
<a
  class="c-comm-board__card"
  href="<%= campaigns_actions_path(type: 'show-communication', id: campaign.id, communication_id: communication.id) %>"
  data-turbo-frame="action"
  aria-label="Apri la comunicazione con <%= contact.name %>"
>
  <div class="c-comm-board__card-head">
    <span class="c-comm-board__avatar"><%= contact.name_2chars %></span>

    <span class="c-comm-board__card-infos">
      <span class="c-comm-board__card-title d-block text-truncate"><%= contact.name %></span>
      <span class="c-comm-board__card-subtitle d-block text-truncate">
        <% if communication.to_send? %>
          In coda dal <%= communication.created_at.strftime('%d/%m/%Y') %>
        <% elsif communication.sent? %>
          Inviata il <%= communication.sent_date.strftime('%d/%m/%Y') %>
        <% else %>
          <%= communication.status_string %> il <%= communication.closed_date.strftime('%d/%m/%Y') %>
        <% end %>
      </span>
    </span>

    <span class="c-comm-board__card-go"><i class="bi bi-chevron-right"></i></span>
  </div>

  <div class="c-comm-board__card-meta">
    <% if communication.sent? %>
      <%# giorni di silenzio dall'ultima mossa (invio o follow-up): giallo dopo
          una settimana, rosso dopo tre, con l'invito ad agire %>
      <span class="badge rounded-pill bg-<%= communication.days_waiting_color %>">
        <i class="bi bi-<%= communication.needs_attention? ? 'exclamation-triangle-fill' : 'hourglass-split' %> me-1"></i>
        <% if silence.zero? %>
          Aggiornata oggi
        <% else %>
          <%= communication.needs_attention? ? 'Da sollecitare' : 'In attesa' %> · <%= silence %>g
        <% end %>
      </span>
    <% end %>

    <% if follow_ups_count.positive? %>
      <span class="badge rounded-pill bg-secondary bg-opacity-75"><i class="bi bi-arrow-repeat me-1"></i><%= follow_ups_count %></span>
    <% end %>

    <% if logs_count.positive? %>
      <span class="badge rounded-pill bg-secondary bg-opacity-75"><i class="bi bi-journal-text me-1"></i><%= logs_count %></span>
    <% end %>

    <% if follow_ups_count.zero? && logs_count.zero? && !communication.sent? %>
      <span class="text-muted">Nessuna attività</span>
    <% end %>
  </div>
</a>
