<%

item ||= Procedure::Item.new
procedure = item.procedure
turbo_frame_status_key ||= nil
statuses ||= procedure.procedures_statuses.order(order: :asc).to_a
turbo_frame_key = dom_id(item, 'kanban-item')


%>

<%= turbo_frame_tag turbo_frame_key, data: { item: item.id } do %>
  <li class="c-kanban__item list-group-item">
    <div class="c-kanban__item-background border-<%= item.resource_color_type %>"></div>
    <div class="c-kanban__item-actions mb-1 d-flex justify-content-between align-items-start">
      <div>
        <span class="c-kanban__item-title"><%= item.secure_title %></span>
      </div>
      <div class="d-flex justify-content-end">
        <div class="dropdown">
          <button class="btn btn-sm btn-outline me-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Apri menu elemento <%= item.secure_title %>">
            <i class="bi bi-three-dots"></i>
          </button>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="<%= procedures_actions_path(type: 'edit-item', id: procedure.id, item_id: item.id, turbo_frame_key: turbo_frame_key) %>" data-turbo-frame="action">Modifica</a></li>
            <% other_statuses = statuses.reject { |status| status.id == item.procedures_status_id } %>
            <% if other_statuses.any? %>
              <%# Touch/mobile fallback for drag & drop: same endpoint and params as kanban_controller.js %>
              <li <%= policy_guard('procedures_edit') %>><hr class="dropdown-divider"></li>
              <li <%= policy_guard('procedures_edit') %>><h6 class="dropdown-header">Sposta in</h6></li>
              <% other_statuses.each do |status| %>
                <li <%= policy_guard('procedures_edit') %>>
                  <%= button_to procedures_move_item_action_path(id: procedure.id, item_id: item.id),
                        params: { procedures_status_id: status.id, render_columns: 1 },
                        class: "dropdown-item d-flex align-items-center",
                        form: { data: { turbo_frame: turbo_frame_key } } do %>
                    <span class="d-inline-block flex-shrink-0 me-2 rounded-circle" style="width: 10px; height: 10px; background-color: <%= status.color %>;" aria-hidden="true"></span>
                    <span class="text-truncate"><%= status.title %></span>
                  <% end %>
                </li>
              <% end %>
              <li <%= policy_guard('procedures_edit') %>><hr class="dropdown-divider"></li>
            <% end %>
            <li <%= policy_guard('procedures_edit') %>><a class="dropdown-item text-danger" href="<%= procedures_actions_path(type: 'remove-item', id: procedure.id, item_id: item.id, turbo_frame_key: turbo_frame_status_key) %>" data-turbo-frame="action">Elimina</a></li>
          </ul>
        </div>
        <button
          <%= policy_guard('procedures_edit') %>
          data-action="keydown->kanban#moveKeydown"
          class="btn btn-sm btn-outline-primary kanban_controller-move-button"
          type="button"
          aria-label="Sposta elemento <%= item.secure_title %>. Usa le frecce per spostarlo tra le colonne o nella colonna."
          aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown"
          data-controller="tooltip"
          data-tooltip="Sposta con le frecce <kbd class='c-kbd'>←</kbd> <kbd class='c-kbd'>→</kbd> <kbd class='c-kbd'>↑</kbd> <kbd class='c-kbd'>↓</kbd>"
        >
          <i class="bi bi-arrows-move kanban_controller-move-button"></i>
        </button>
        <a
          class="d-none kanban_controller-item-updater"
          href="<%= procedures_move_item_action_path(id: procedure.id, item_id: item.id) %>"
          data-turbo-method="post"
          data-turbo-frame="<%= turbo_frame_key %>"
        ></a>
      </div>
    </div>
    <div class="c-kanban__item-card">
      <%= render 'procedures/shared/card-item', item: item, turbo_frame_key: turbo_frame_key %>
    </div>
  </li>
<% end %>
