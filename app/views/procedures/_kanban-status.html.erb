<%

status ||= Procedure::Status.new
procedure = status.procedure
turbo_frame_key = dom_id(status, 'kanban-status')
items = status.persisted? ? status.procedures_items_ordered_and_filtered.to_a : []
# Loaded once per column so each card's "Sposta in" menu doesn't query the statuses again
statuses = procedure.procedures_statuses.order(order: :asc).to_a

%>

<%= turbo_frame_tag turbo_frame_key do %>
  <div class="c-kanban__status card d-flex flex-direction-column justify-content-between me-3">
    <div class="c-kanban__status-header card-header d-flex align-items-center justify-content-between border-bottom-0 rounded-bottom">
      <div
        class="d-flex align-items-center flex-grow-1 min-w-0"
        <% unless status.description.blank? %>
        data-controller="tooltip"
        data-tooltip="<%= status.description %>"
        <% end %>
      >
        <span class="d-inline-block flex-shrink-0 me-1 border border-white border-2" style="width: 18px; height: 18px; border-radius: 50%; background-color: <%= status.color %>;"></span>
        <span class="fw-bold text-truncate min-w-0" title="<%= status.title %>"><%= status.title %></span>
        <span class="badge rounded-pill text-white flex-shrink-0 ms-2 h-fs-xxs <%= items.any? ? 'bg-info' : 'bg-dark' %>" aria-label="<%= pluralize(items.length, 'elemento', plural: 'elementi') %>"><%= items.length %></span>
      </div>
      <div
        class="ms-3 d-flex"
      >
        <div class="dropdown" <%= policy_guard('procedures_edit') %>>
          <button
            class="btn btn-sm btn-outline"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Apri menu stato <%= status.title %>"
          >
            <i class="bi bi-three-dots"></i>
          </button>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="<%= procedures_actions_path(type: 'show-status-automations', id: procedure.id, status_id: status.id) %>" data-turbo-frame="action">Automazioni</a></li>
            <% if procedure.resources_type_tasks? %>
              <li><a class="dropdown-item" href="<%= procedures_actions_path(type: 'show-status-assignments', id: procedure.id, status_id: status.id) %>" data-turbo-frame="action">Assegnazioni</a></li>
            <% end %>
            <li><a class="dropdown-item" href="<%= procedures_actions_path(type: 'edit-status', id: procedure.id, status_id: status.id) %>" data-turbo-frame="action">Modifica</a></li>
            <li><a class="dropdown-item" href="<%= procedures_duplicate_status_action_path(id: procedure.id, status_id: status.id) %>" data-turbo-method="post" data-turbo-frame="<%= dom_id(procedure, 'kanban') %>">Duplica</a></li>
            <% if status.can_move?('left-full') %>
              <li><a class="dropdown-item" href="<%= procedures_move_status_action_path(id: procedure.id, status_id: status.id, direction: 'left-full') %>" data-turbo-method="post" data-turbo-frame="<%= dom_id(procedure, 'kanban') %>">Sposta all'inizio</a></li>
            <% else %>
              <li><button class="dropdown-item" disabled >Sposta all'inizio</button></li>
            <% end %>
            <% if status.can_move?('right-full') %>
              <li><a class="dropdown-item" href="<%= procedures_move_status_action_path(id: procedure.id, status_id: status.id, direction: 'right-full') %>" data-turbo-method="post" data-turbo-frame="<%= dom_id(procedure, 'kanban') %>">Sposta in fondo</a></li>
            <% else %>
              <li><button class="dropdown-item" disabled>Sposta in fondo</button></li>
            <% end %>
            <li><a class="dropdown-item text-danger" href="<%= procedures_actions_path(type: 'remove-status', id: procedure.id, status_id: status.id) %>" data-turbo-frame="action">Elimina</a></li>
          </ul>
        </div>
        <% if procedure.resources_type_tasks? && !procedure.model %>
          <div class="dropdown ms-1">
            <button
              class="btn btn-sm btn-link text-dark"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              aria-label="Apri menu acquisizione task per <%= status.title %>"
            >
              <i class="bi bi-kanban-fill"></i>
            </button>
            <ul class="dropdown-menu">
              <li>
                <a
                  class="dropdown-item"
                  href="<%= procedures_take_tasks_to_status_action_path(id: procedure.id, status_id: status.id, tasks_type: 'not_completed_present_past') %>"
                  data-turbo-method="post"
                  data-turbo-frame="<%= dom_id(procedure, 'kanban') %>"
                >
                  Prendi task non completati scaduti
                </a>
              </li>
              <li>
                <a
                  class="dropdown-item"
                  href="<%= procedures_take_tasks_to_status_action_path(id: procedure.id, status_id: status.id, tasks_type: 'not_completed_future') %>"
                  data-turbo-method="post"
                  data-turbo-frame="<%= dom_id(procedure, 'kanban') %>"
                >
                  Prendi task non completati futuri
                </a>
              </li>
              <li>
                <a
                  class="dropdown-item"
                  href="<%= procedures_take_tasks_to_status_action_path(id: procedure.id, status_id: status.id, tasks_type: 'not_completed') %>"
                  data-turbo-method="post"
                  data-turbo-frame="<%= dom_id(procedure, 'kanban') %>"
                >
                  Prendi task non completati
                </a>
              </li>
              <li>
                <a
                  class="dropdown-item"
                  href="<%= procedures_take_tasks_to_status_action_path(id: procedure.id, status_id: status.id, tasks_type: 'completed') %>"
                  data-turbo-method="post"
                  data-turbo-frame="<%= dom_id(procedure, 'kanban') %>"
                >
                  Prendi task completati
                </a>
              </li>
            </ul>
          </div>
        <% end %>
        <% if status.can_move?('left') %>
          <a
            class="btn btn-sm ms-1"
            href="<%= procedures_move_status_action_path(id: procedure.id, status_id: status.id, direction: 'left') %>"
            data-turbo-method="post"
            data-turbo-frame="<%= dom_id(procedure, 'kanban') %>"
            <%= policy_guard('procedures_edit') %>
            data-controller="tooltip"
            data-tooltip="Sposta a sinistra"
            aria-label="Sposta stato <%= status.title %> a sinistra"
          ><i class="bi bi-arrow-left"></i></a>
        <% end %>
        <% if status.can_move?('right') %>
          <a
            class="btn btn-sm ms-1"
            href="<%= procedures_move_status_action_path(id: procedure.id, status_id: status.id, direction: 'right') %>"
            data-turbo-method="post"
            data-turbo-frame="<%= dom_id(procedure, 'kanban') %>"
            <%= policy_guard('procedures_edit') %>
            data-controller="tooltip"
            data-tooltip="Sposta a destra"
            aria-label="Sposta stato <%= status.title %> a destra"
          ><i class="bi bi-arrow-right"></i></a>
        <% end %>
      </div>
    </div>
    <%# safe_join keeps the <ul> free of stray whitespace, so :empty (and its %>
    <%# "drop here" hint) matches when the column has no items %>
    <ul class="list-group list-group-flush h-fullscroll c-kanban__container" data-kanban-target="container" data-container="<%= status.id %>" data-status-title="<%= status.title %>"><%= safe_join(items.map { |item| render("procedures/kanban-item", item: item, turbo_frame_status_key: turbo_frame_key, statuses: statuses) }) %></ul>
    <div class="card-footer d-flex">
      <% if procedure.resources_type_tasks? && !procedure.model %>
        <%# The column is re-rendered (stream/broadcast) on every add: the controller %>
        <%# keeps open state and draft per status across those replacements %>
        <div
          class="w-100"
          data-controller="kanban-quick-add"
          data-kanban-quick-add-key-value="<%= status.id %>"
          <%= policy_guard('tasks_create') %>
        >
          <button type="button" class="btn btn-outline-primary btn-sm w-100" data-kanban-quick-add-target="toggle" data-action="kanban-quick-add#open">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Aggiungi
          </button>
          <%= form_tag procedures_quick_add_item_action_path(id: procedure.id), hidden: true, data: { kanban_quick_add_target: "form", action: "turbo:submit-start->kanban-quick-add#submitStart turbo:submit-end->kanban-quick-add#submitEnd" } do %>
            <input type="hidden" name="procedures_status_id" value="<%= status.id %>">
            <input
              type="text"
              name="title"
              class="form-control form-control-sm"
              placeholder="Titolo del task"
              aria-label="Titolo del nuovo task in <%= status.title %>"
              maxlength="200"
              autocomplete="off"
              required
              data-kanban-quick-add-target="input"
              data-action="input->kanban-quick-add#input keydown->kanban-quick-add#keydown"
            >
            <div class="d-flex align-items-center justify-content-between mt-1">
              <a href="<%= procedures_actions_path(type: 'add-item', id: procedure.id, procedures_status_id: status.id, turbo_frame_key: turbo_frame_key) %>" data-turbo-frame="action" class="small" data-kanban-quick-add-target="details" data-action="kanban-quick-add#details">Più dettagli</a>
              <small class="text-muted d-none d-md-inline">Invio per aggiungere</small>
              <button type="button" class="btn btn-sm btn-link text-dark p-0" data-action="kanban-quick-add#close" aria-label="Chiudi aggiunta rapida">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
              </button>
            </div>
          <% end %>
        </div>
      <% elsif procedure.resources_type_projects? && !procedure.model %>
        <a href="<%= procedures_actions_path(type: 'add-item', id: procedure.id, procedures_status_id: status.id, turbo_frame_key: turbo_frame_key) %>" data-turbo-frame="action" class="btn btn-primary w-100 me-1" <%= policy_guard('projects_create') %>>
          Nuovo
        </a>
        <a href="<%= procedures_actions_path(type: 'add-item-existing', id: procedure.id, procedures_status_id: status.id, turbo_frame_key: turbo_frame_key) %>" data-turbo-frame="action" class="btn btn-primary w-100 ms-1" >Esistente</a>
      <% elsif procedure.resources_type_projects? && procedure.model %>
        <a href="<%= procedures_actions_path(type: 'add-item', id: procedure.id, procedures_status_id: status.id, turbo_frame_key: turbo_frame_key) %>" data-turbo-frame="action" class="btn btn-primary w-100" <%= policy_guard('procedures_edit') %>>
          Aggiungi progetto
        </a>
      <% elsif procedure.resources_type_tasks? && procedure.model %>
        <a href="<%= procedures_actions_path(type: 'add-item', id: procedure.id, procedures_status_id: status.id, turbo_frame_key: turbo_frame_key) %>" data-turbo-frame="action" class="btn btn-primary w-100" <%= policy_guard('procedures_edit') %>>
          Aggiungi task
        </a>
      <% end %>
    </div>
  </div>
<% end %>
