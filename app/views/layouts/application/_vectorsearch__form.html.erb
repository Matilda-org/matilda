<%= turbo_frame_tag "vectorsearch_#{@session_user_id}_form" do %>
  <%= form_tag vectorsearch_send_message_path, class: 'd-flex align-items-center' do %>
    <div class="me-3" style="flex: 1">
      <textarea
        class="form-control"
        name="message"
        rows="2"
        placeholder="Scrivi un messaggio..."
        data-vectorsearch-target="textarea"
      ></textarea>
      <%# Hint tastiera: solo desktop, su mobile si tocca il bottone %>
      <small class="text-muted d-none d-md-block mt-1">
        <kbd class="c-kbd">Invio</kbd> invia &middot; <kbd class="c-kbd">Maiusc + Invio</kbd> a capo
      </small>
    </div>

    <button type="submit" class="btn btn-primary" data-vectorsearch-target="submit" aria-label="Invia messaggio">
      <i class="bi bi-send-fill"></i>
    </button>
  <% end %>
<% end %>
