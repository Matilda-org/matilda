<div class="sidebar h-100" data-controller="sidebar" data-action="show.bs.dropdown->sidebar#closeOthers">
  <ul class="nav flex-column ps-3" id="sidebar-nav">
    <%= render 'layouts/application/menu', operative: true %>

    <li class="sidebar__collapse mt-auto">
      <button
        type="button"
        class="sidebar__collapse-btn"
        data-sidebar-target="toggle"
        data-action="sidebar#toggleCollapsed"
        aria-controls="sidebar-nav"
        aria-expanded="true"
      ><i class="bi bi-chevron-double-left" aria-hidden="true"></i><span data-sidebar-target="toggleLabel">Riduci menu</span></button>
    </li>
  </ul>
</div>
