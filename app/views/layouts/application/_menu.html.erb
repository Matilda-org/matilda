<%

# The sidebar (md+) and the collapsed navbar (mobile) share this menu
operative ||= false
item_class = operative ? 'shadow-sm' : 'd-md-none'
projects_open = @_navbar == 'projects'
crm_open = %w[crm contacts campaigns].include?(@_navbar)
credentials_open = @_navbar == 'credentials'

# Sidebar submenus are inline: only the current section starts expanded
submenu_class = ->(open) { operative && open ? 'show' : '' }
submenu_toggle = operative ? { 'data-bs-auto-close': 'false' } : {}

%>

<% if operative %>
  <li class="sidebar__group" aria-hidden="true">Lavoro</li>
<% end %>

<li class="nav-item <%= item_class %>">
  <a class="nav-link w-100 <%= @_navbar == 'dashboard' ? 'active' : '' %>" href="<%= users_show_path(@session_user_id) %>" data-turbo-frame="_top"><%= nav_icon('dashboard') %> <span class="ms-2">Dashboard</span></a>
</li>

<li class="nav-item <%= item_class %>" <%= policy_guard('tasks_index') %>>
  <a class="nav-link w-100 <%= @_navbar == 'tasks' ? 'active' : '' %>" href="<%= tasks_path(user_id: @session_user_id) %>" data-turbo-frame="_top"><%= nav_icon('tasks') %> <span class="ms-2">Task</span></a>
</li>

<li class="nav-item <%= item_class %> dropdown" <%= policy_guard('projects_index') %>>
  <a class="nav-link w-100 <%= projects_open ? 'active' : '' %>" href="#" data-bs-toggle="dropdown" aria-expanded="<%= operative && projects_open %>" <%= tag.attributes(submenu_toggle) %>><%= nav_icon('projects') %> <span class="ms-2">Progetti</span></a>
  <ul class="dropdown-menu mt-2 mt-md-0 <%= submenu_class.call(projects_open) %>" style="border-bottom: none;">
    <li><a class="dropdown-item <%= projects_open && !params[:without_folder] && !params[:folder_id] ? 'active' : '' %>" href="<%= projects_path %>" data-turbo-frame="_top">Tutti i progetti</a></li>
    <li><a class="dropdown-item <%= projects_open && !!params[:without_folder] && !params[:folder_id] ? 'active' : '' %>" href="<%= projects_path(without_folder: 1) %>" data-turbo-frame="_top">Non assegnati</a></li>
    <%= render 'layouts/application/navbar__folders', base_path: projects_path, active_folder_id: projects_open ? params[:folder_id] : nil, show_for: 'projects' %>
  </ul>
</li>

<li class="nav-item <%= item_class %>" <%= policy_guard('procedures_index') %>>
  <a class="nav-link w-100 <%= @_navbar == 'procedures' ? 'active' : '' %>" href="<%= procedures_path %>" data-turbo-frame="_top"><%= nav_icon('procedures') %> <span class="ms-2">Board</span></a>
</li>

<% if operative && policy?('crm') %>
  <li class="sidebar__group" aria-hidden="true">Relazioni</li>
<% end %>

<li class="nav-item <%= item_class %> dropdown" <%= policy_guard('crm') %>>
  <a class="nav-link w-100 <%= crm_open ? 'active' : '' %>" href="#" data-bs-toggle="dropdown" aria-expanded="<%= operative && crm_open %>" <%= tag.attributes(submenu_toggle) %>><%= nav_icon('crm') %> <span class="ms-2">CRM</span></a>
  <ul class="dropdown-menu mt-2 mt-md-0 <%= submenu_class.call(crm_open) %>">
    <li><a class="dropdown-item <%= @_navbar == 'crm' ? 'active' : '' %>" href="<%= crm_path %>" data-turbo-frame="_top">Dashboard</a></li>
    <li><a class="dropdown-item <%= @_navbar == 'contacts' ? 'active' : '' %>" href="<%= contacts_path %>" data-turbo-frame="_top">Contatti</a></li>
    <li><a class="dropdown-item <%= @_navbar == 'campaigns' ? 'active' : '' %>" href="<%= campaigns_path %>" data-turbo-frame="_top">Campagne</a></li>
  </ul>
</li>

<% if operative && %w[credentials_index posts_index users_index].any? { |p| policy?(p) } %>
  <li class="sidebar__group" aria-hidden="true">Risorse</li>
<% end %>

<li class="nav-item <%= item_class %> dropdown" <%= policy_guard('credentials_index') %>>
  <a class="nav-link w-100 <%= credentials_open ? 'active' : '' %>" href="#" data-bs-toggle="dropdown" aria-expanded="<%= operative && credentials_open %>" <%= tag.attributes(submenu_toggle) %>><%= nav_icon('credentials') %> <span class="ms-2">Credenziali</span></a>
  <ul class="dropdown-menu mt-2 mt-md-0 <%= submenu_class.call(credentials_open) %>">
    <li><a class="dropdown-item <%= credentials_open && !params[:without_folder] && !params[:folder_id] ? 'active' : '' %>" href="<%= credentials_path %>" data-turbo-frame="_top">Tutte le credenziali</a></li>
    <li><a class="dropdown-item <%= credentials_open && !!params[:without_folder] ? 'active' : '' %>" href="<%= credentials_path(without_folder: 1) %>" data-turbo-frame="_top">Non assegnate</a></li>
    <%= render 'layouts/application/navbar__folders', base_path: credentials_path, active_folder_id: credentials_open ? params[:folder_id] : nil, show_for: 'credentials' %>
  </ul>
</li>

<li class="nav-item <%= item_class %>" <%= policy_guard('posts_index') %>>
  <a class="nav-link w-100 <%= @_navbar == 'posts' ? 'active' : '' %>" href="<%= posts_path %>" data-turbo-frame="_top"><%= nav_icon('posts') %> <span class="ms-2">Bacheca</span></a>
</li>

<li class="nav-item <%= item_class %>" <%= policy_guard('users_index') %>>
  <a class="nav-link w-100 <%= @_navbar == 'users' ? 'active' : '' %>" href="<%= users_path %>" data-turbo-frame="_top"><%= nav_icon('users') %> <span class="ms-2">Utenti</span></a>
</li>
