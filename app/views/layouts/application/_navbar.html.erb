<%= turbo_frame_tag 'navbar' do %>
  <nav class="navbar shadow fixed-top navbar-expand-lg">
    <div class="container-fluid">
      <div class="navbar-wrapper d-flex flex-wrap <%= @session_user ? 'justify-content-between' : 'justify-content-center' %>">
        <a class="navbar-brand" href="<%= root_path %>" data-turbo="false">
          <%= render 'layouts/application/logo' %>
          <span>MATILDA</span>
        </a>

        <% if @session_user %>
          <%= form_tag users_show_path(@session_user_id), method: :get, class: "c-global-search d-none d-md-flex mx-3 flex-grow-1", role: "search", data: { turbo_frame: "_top", controller: "global-search", action: "keydown@window->global-search#focus" } do %>
            <label for="global-search" class="visually-hidden">Cerca progetti, task, credenziali</label>
            <i class="bi bi-search c-global-search__icon" aria-hidden="true"></i>
            <input type="search" id="global-search" name="search" class="form-control form-control-sm" placeholder="Cerca progetti, task, credenziali" minlength="3" value="<%= params[:search] if @_is_dashboard %>" data-global-search-target="input">
            <kbd class="c-kbd c-global-search__hint" data-global-search-target="hint">Ctrl K</kbd>
          <% end %>

          <div class="d-flex align-items-center">
            <a class="btn btn-link text-white d-md-none me-1 fs-5" href="<%= users_show_path(@session_user_id, anchor: "dashboard-search") %>" data-turbo-frame="_top" aria-label="Cerca"><i class="bi bi-search"></i></a>
            <div class="me-2">
              <%= render 'tasks/tracker' %>
            </div>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Apri menu">
              <i class="bi bi-list"></i>
            </button>
          </div>

          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <div class="me-auto"></div>
            <ul class="navbar-nav mb-2 mt-3 mt-lg-0 mb-lg-0">
              <%= render 'layouts/application/menu' %>

              <li class="nav-item" <%= policy_guard('tools') %>>
                <a
                  class="nav-link w-100 <%= @_navbar == 'tools' ? 'active' : '' %>"
                  href="<%= tools_path %>"
                  data-turbo-frame="_top"
                  data-controller="tooltip"
                  data-tooltip="Strumenti"
                  aria-label="Strumenti"
                ><%= nav_icon('tools') %> <span class="d-lg-none ms-2">Strumenti</span></a>
              </li>

              <li class="nav-item" <%= policy_guard('settings') %>>
                <a
                  class="nav-link w-100 <%= @_navbar == 'settings' ? 'active' : '' %>"
                  href="<%= settings_path %>"
                  data-turbo-frame="_top"
                  data-controller="tooltip"
                  data-tooltip="Impostazioni"
                  aria-label="Impostazioni"
                ><%= nav_icon('settings') %> <span class="d-lg-none ms-2">Impostazioni</span></a>
              </li>

              <li class="nav-item">
                <a
                  class="nav-link w-100"
                  href="<%= authentication_logout_path %>"
                  data-turbo="false"
                  data-controller="tooltip"
                  data-tooltip="Esci"
                  aria-label="Esci"
                ><i class="bi bi-door-closed-fill"></i> <span class="d-lg-none ms-2">Esci</span></a>
              </li>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  </nav>
<% end %>
