<%

folders ||= @global_cache.folders
base_path ||= '#'
active_folder_id ||= nil
count_key ||= nil

# only folders with something to show; the active one stays, even if empty
if count_key
  folders = folders.select { |folder| folder[count_key].to_i.positive? || folder[:id] == active_folder_id.to_i }
end

# reorder folders to put the active folder on top
if active_folder_id
  folders = folders.partition { |folder| folder[:id] == active_folder_id.to_i }.flatten
end

%>

<% if folders.length.positive? %>
  <li><hr class="dropdown-divider"></li>
  <li class="sidebar__folders">
    <ul class="h-list-none sidebar__folders-list" style="max-height: 300px; overflow-y: auto;">
      <% folders.each do |folder| %>
        <li
          class="<%= active_folder_id&.to_i == folder[:id] ? 'pb-2 mb-2 border-bottom' : '' %>"
        >
          <a
            class="dropdown-item <%= active_folder_id&.to_i == folder[:id] ? 'active' : '' %> h-text-oneline"
            href="<%= base_path %>/<%= folder[:id] %>"
            data-turbo-frame="_top"
          >
            <small>
              <i class="bi bi-folder-fill me-1"></i>
              <%= folder[:name] %>
            </small>
          </a>
        </li>
      <% end %>
    </ul>
  </li>
<% end %>
<li <%= policy_guard('folders_create') %>><hr class="dropdown-divider"></li>
<li <%= policy_guard('folders_create') %>><a class="dropdown-item" href="<%= folders_actions_path(type: 'create') %>" data-turbo-frame="action"><i class="bi bi-plus-circle me-2"></i> Nuova cartella</a></li>
