<%

user ||= User.new

title = safe_join([
  image_tag(user.image_profile_url, alt: "", class: "c-avatar-sm rounded-circle border border-primary border-2 me-1"),
  tag.span(" #{user.complete_name} ", class: "align-middle")
])

%>

<%= render 'shared/card',
  nav_icon_key: 'users',
  title: title,
  subtitle: user.email,
  render_actions: 'users/shared/card-actions',
  render_actions_args: { user: user } %>
